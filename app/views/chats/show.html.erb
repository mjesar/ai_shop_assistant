<%= link_to "← Back to chats", chats_path, class: "text-sm text-gray-600 hover:text-gray-900 mb-2 inline-block" %>

<h1 class="text-2xl font-bold mb-4">Chat with <%= @chat.model_id %></h1>

<%= turbo_stream_from @chat %>

<div data-controller="chat">
  <div id="messages" class="space-y-3 mb-6" data-chat-target="messages">
    <%= render @chat.messages %>
  </div>

  <%= form_with url: chat_messages_path(@chat), method: :post,
      data: { action: "turbo:submit-start->chat#submit turbo:submit-end->chat#submitEnd" } do |form| %>
    <%= form.text_field :content, placeholder: "Ask something...", class: "border rounded px-3 py-2 w-full", data: { chat_target: "input" } %>
    <%= form.submit "Send", class: "bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded mt-2", data: { chat_target: "button" } %>
  <% end %>
</div>
